<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title> PianoCSS </title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="css/style.css">
    <script type="application/javascript" src="js/jquery.min.js"></script>
  </head>
  <body>
    <main>

        <!-- 
        ///// PIANO //////
        -->
        
        <div id="playPiano">
            <div id="piano">
                <canvas id="piano-background"></canvas>
                <div id="all-keys">
                    <pointer-key>
                    </pointer-key>
                    <div class="octave">
                        <div class="white-keys">
                                    <canvas class="C"></canvas>
                                    <canvas class="D"></canvas>
                                    <canvas class="E"></canvas>
                                    <canvas class="F"></canvas>
                                    <canvas class="G"></canvas>
                                    <canvas class="A"></canvas>
                                    <canvas class="B"></canvas>
                        </div>
                        <div class="black-keys">
                            <div class="left-part">  
                                <div class="keys">
                                    <canvas class="C#/Db"></canvas>
                                    <canvas class="D#/Eb"></canvas>
                                </div>
                            </div>
                            <div class="right-part">
                                <div class="keys">
                                    <canvas class="F#/Gb"></canvas>
                                    <canvas class="G#/Ab"></canvas>
                                    <canvas class="A#/Bb"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="btn-remove-highlights">Remove highlighted keys</button>
        </div>

        <!-- 
        ////// PIANO /////// 
        -->

    </main>  
    <script type="application/javascript" src="js/piano.mjs"></script>  
    <script type="application/javascript" src="js/anime.min.js"></script>  
    <script type="application/javascript" src="js/OUI.js"></script>  
    <script type="application/javascript" src="js/canvas.js"></script>  
  </body>
</html>
